{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ak5-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-03-19",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Enable Cloudflare version preview URLs.
	"preview_urls": true,
	"routes": [{ "pattern": "www.__PROD_DOMAIN__", "custom_domain": true }],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"vars": {
		"PUBLIC_API_URL": "https://api.__PROD_DOMAIN__",
		"PUBLIC_APP_URL": "https://www.__PROD_DOMAIN__",
		"PUBLIC_ADMIN_URL": "https://admin.__PROD_DOMAIN__",
		"PUBLIC_COOKIE_ORIGIN": ".__PROD_DOMAIN__"
	},
	// The api worker, bound as a service so server-side calls reach it directly
	// (Cloudflare blocks same-account worker→worker fetches over public URLs —
	// error 1042). Used by src/lib/api.ts; staging binds the -stg api below.
	"services": [{ "binding": "API", "service": "ak5-api" }],
	// Secret: JWT_SECRET (to verify auth cookies locally without an api hop).
	//
	// Staging (`--env staging`): workers.dev-only, points at the staging api,
	// host-only cookies (empty PUBLIC_COOKIE_ORIGIN — see api wrangler.jsonc).
	"env": {
		"staging": {
			"name": "ak5-web-stg",
			"routes": [],
			"vars": {
				"PUBLIC_API_URL": "https://ak5-api-stg.ak5.workers.dev",
				"PUBLIC_APP_URL": "https://ak5-web-stg.ak5.workers.dev",
				"PUBLIC_ADMIN_URL": "https://ak5-admin-stg.ak5.workers.dev",
				"PUBLIC_COOKIE_ORIGIN": ""
			},
			"services": [{ "binding": "API", "service": "ak5-api-stg" }]
		}
	}
}
