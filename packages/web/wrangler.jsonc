{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ak5-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"preview_urls": true,
	"routes": [
		{
			"pattern": "www.__PROD_DOMAIN__",
			"custom_domain": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"vars": {
		"PUBLIC_API_URL": "https://api.__PROD_DOMAIN__",
		"PUBLIC_APP_URL": "https://www.__PROD_DOMAIN__",
		"PUBLIC_ADMIN_URL": "https://admin.__PROD_DOMAIN__",
		"PUBLIC_COOKIE_ORIGIN": ".__PROD_DOMAIN__",
		"PUBLIC_DEPLOY_ENVIRONMENT": "",
		"PUBLIC_ENV_BANNER": "true"
	},
	"services": [
		{
			"binding": "API",
			"service": "ak5-api"
		}
	],
	"env": {
		"development": {
			"name": "ak5-web-stg",
			"routes": [],
			"vars": {
				"PUBLIC_API_URL": "https://ak5-api-stg.ak5.workers.dev",
				"PUBLIC_APP_URL": "https://ak5-web-stg.ak5.workers.dev",
				"PUBLIC_ADMIN_URL": "https://ak5-admin-stg.ak5.workers.dev",
				"PUBLIC_COOKIE_ORIGIN": "",
				"PUBLIC_DEPLOY_ENVIRONMENT": "Development",
				"PUBLIC_ENV_BANNER": "true"
			},
			"services": [
				{
					"binding": "API",
					"service": "ak5-api-stg"
				}
			]
		},
		"staging": {
			"name": "ak5-web-staging",
			"routes": [],
			"vars": {
				"PUBLIC_API_URL": "https://ak5-api-staging.ak5.workers.dev",
				"PUBLIC_APP_URL": "https://ak5-web-staging.ak5.workers.dev",
				"PUBLIC_ADMIN_URL": "https://ak5-admin-staging.ak5.workers.dev",
				"PUBLIC_COOKIE_ORIGIN": "",
				"PUBLIC_DEPLOY_ENVIRONMENT": "Staging",
				"PUBLIC_ENV_BANNER": "true"
			},
			"services": [
				{
					"binding": "API",
					"service": "ak5-api-staging"
				}
			]
		}
	}
}
