# Web is a pure UI worker — only the env vars it actually reads.

# Where the api worker lives. Slot 1 dev → http://api.ak5.localhost:8359.
PUBLIC_API_URL=http://api.ak5.localhost:8359

# Web's own canonical URL (used in redirects / links).
PUBLIC_APP_URL=http://web.ak5.localhost:8359

# Admin app URL, used when returning from impersonation.
PUBLIC_ADMIN_URL=http://admin.ak5.localhost:8359

# Cookie domain — must match COOKIE_ORIGIN on @ak5/api so the JWT cookie lives
# at .ak5.localhost and is shared across the api/web/admin subdomains. This file
# is DEV only; hosted dev/staging ("") / prod (.ak5web.com) values live in wrangler.jsonc
# `vars` — see docs/operations/deployment.md.
PUBLIC_COOKIE_ORIGIN=.ak5.localhost

# Must match @ak5/api JWT_SECRET so hooks.server.ts can verify cookies locally.
JWT_SECRET=

# Show a dismissible environment banner; resets after navigation or reload.
PUBLIC_ENV_BANNER=true
PUBLIC_DEPLOY_ENVIRONMENT=Development
