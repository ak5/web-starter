# Must match @ak5/api and @ak5/web (same JWT_SECRET in all three workers).
JWT_SECRET=

# API origin the admin app talks to.
PUBLIC_API_URL=http://api.ak5.localhost:8359

# Cookie domain matching the slot (.ak5.localhost / .ak5<n>.localhost). DEV only;
# staging ("") / prod (.ak5web.com) values live in wrangler.jsonc `vars` — see
# docs/operations/deployment.md.
PUBLIC_COOKIE_ORIGIN=.ak5.localhost
