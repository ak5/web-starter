{
	"include": [
		"src/**/*",
		"workers/**/*",
		".react-router/types/**/*",
		"worker-configuration.d.ts",
		"vite.config.ts",
		"react-router.config.ts"
	],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["node", "vite/client"],
		"rootDirs": [".", "./.react-router/types"]
	}
}
