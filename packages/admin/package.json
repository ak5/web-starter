{
	"name": "@ak5/admin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host ${DEV_HOST:-localhost} --port ${AK5_ADMIN_PORT:-8352}",
		"build": "react-router build",
		"preview": "react-router build --mode local-preview && vite preview",
		"check": "react-router typegen && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint --cache .",
		"lint:nofmt": "eslint --cache .",
		"lint:fix": "prettier --write . && eslint --cache --fix .",
		"lint:fix:nofmt": "eslint --cache --fix .",
		"gen": "wrangler types --env-file .env.example --include-env false",
		"cf-typegen": "pnpm gen"
	},
	"devDependencies": {
		"@ak5/api": "workspace:*",
		"@cloudflare/vite-plugin": "^1.70.1",
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "^8.5.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.5",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "~8.72.2",
		"vite": "^8.3.8",
		"wrangler": "^4.166.0"
	},
	"dependencies": {
		"@ak5/webui": "workspace:*",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.2"
	}
}
