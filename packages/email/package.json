{
	"name": "@ak5/email",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc --emitDeclarationOnly",
		"dev": "concurrently -k \"vite build --watch\" \"tsc --emitDeclarationOnly --watch --preserveWatchOutput\"",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint --cache .",
		"lint:nofmt": "eslint --cache .",
		"lint:fix": "prettier --write . && eslint --cache --fix .",
		"lint:fix:nofmt": "eslint --cache --fix .",
		"dev:preview": "vite --host 127.0.0.1 --port ${AK5_PREVIEW_PORT:-8354} --strictPort",
		"dev:mock": "PORT=${AK5_MOCK_PORT:-8355} tsx scripts/mock-server.ts",
		"test:unit": "pnpm build && node --test --test-concurrency=1 --import tsx scripts/preview.test.ts src/render.test.ts src/send.test.ts scripts/rest-send.test.ts",
		"test:send": "pnpm build && tsx scripts/send-test.ts",
		"preview": "pnpm dev:preview",
		"mock": "pnpm dev:mock"
	},
	"dependencies": {
		"@better-svelte-email/components": "2.3.0",
		"@better-svelte-email/server": "2.3.0",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hono/node-server": "^2.1.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"hono": "^4.13.13",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"concurrently": "^10.0.6",
		"eslint-plugin-svelte": "^3.23.1",
		"parse5": "^8.0.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.7",
		"vite": "^8.3.5",
		"@types/node": "^26.6.5"
	}
}
