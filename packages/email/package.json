{
	"name": "@ak5/email",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc --emitDeclarationOnly",
		"dev": "concurrently -k \"vite build --watch\" \"tsc --emitDeclarationOnly --watch --preserveWatchOutput\"",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint --cache .",
		"lint:nofmt": "eslint --cache .",
		"lint:fix": "prettier --write . && eslint --cache --fix .",
		"lint:fix:nofmt": "eslint --cache --fix .",
		"dev:preview": "vite --host 127.0.0.1 --port ${AK5_PREVIEW_PORT:-8354} --strictPort",
		"dev:mock": "PORT=${AK5_MOCK_PORT:-8355} tsx scripts/mock-server.ts",
		"test:unit": "pnpm build && node --test --test-concurrency=1 --import tsx scripts/mock-server.test.ts scripts/preview.test.ts src/render.test.ts src/send.test.ts scripts/rest-send.test.ts",
		"test:send": "pnpm build && tsx scripts/send-test.ts",
		"preview": "pnpm dev:preview",
		"mock": "pnpm dev:mock"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-email": "^6.11.16"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hono/node-server": "2.1.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^10.0.7",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"hono": "^4.13.20",
		"parse5": "^8.1.1",
		"prettier": "^3.10.1",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "~8.72.2",
		"vite": "^8.3.8"
	}
}
