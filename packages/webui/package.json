{
	"name": "@ak5/webui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./components/*.svelte": {
			"types": "./dist/components/*.svelte.d.ts",
			"svelte": "./dist/components/*.svelte",
			"default": "./dist/components/*.svelte"
		},
		"./lib/*": {
			"types": "./dist/*.d.ts",
			"svelte": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "svelte-package",
		"package": "svelte-package",
		"dev": "svelte-package --watch",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint --cache .",
		"lint:nofmt": "eslint --cache .",
		"lint:fix": "prettier --write . && eslint --cache --fix .",
		"lint:fix:nofmt": "eslint --cache --fix ."
	},
	"dependencies": {
		"@ak5/shared": "workspace:*",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@lucide/svelte": "^1.61.0",
		"hono": "^4.13.13",
		"melt": "^0.44.0",
		"nanoid": "^6.0.2",
		"runed": "^0.38.0",
		"svelte-fa": "^4.0.4",
		"svelte-portal": "^2.2.1",
		"webpfy": "^1.0.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
