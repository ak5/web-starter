{
	"name": "@ak5/shared",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./cookie": {
			"types": "./src/cookie.ts",
			"react-native": "./dist/cookie.js",
			"default": "./src/cookie.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"check": "tsc --noEmit",
		"test:unit": "node --test --import tsx 'src/**/*.test.ts'",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint --cache .",
		"lint:nofmt": "eslint --cache .",
		"lint:fix": "prettier --write . && eslint --cache --fix .",
		"lint:fix:nofmt": "eslint --cache --fix ."
	},
	"dependencies": {
		"countries-list": "^3.4.1",
		"nanoid": "^5.1.16",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0"
	}
}
