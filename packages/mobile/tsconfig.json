{
	"extends": "@react-native/typescript-config",
	"compilerOptions": {
		"types": ["node", "svelte"],
		"plugins": [
			{
				"name": "@symbiote-native/css-parser/typescript-plugin"
			}
		],
		"allowImportingTsExtensions": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "**/*.svelte"],
	"exclude": ["**/node_modules", "**/Pods", "e2e"]
}
