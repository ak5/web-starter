{
	"name": "@ak5/mobile",
	"version": "0.0.1",
	"private": true,
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@babel/plugin-transform-dynamic-import": "^7.29.7",
		"@babel/runtime": "^7.29.15",
		"@eslint/js": "^10.0.1",
		"@react-native/codegen": "0.88.0",
		"@react-native/gradle-plugin": "0.88.0",
		"@react-native/typescript-config": "0.88.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@typescript-eslint/parser": "~8.72.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"hermes-compiler": "260318099.0.4",
		"prettier": "^3.10.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "~8.72.2"
	},
	"engines": {
		"node": ">=26.12.1"
	},
	"scripts": {
		"dev": "node scripts/metro.mjs",
		"ios": "node scripts/run.mjs ios",
		"android": "node scripts/run.mjs android",
		"ios:release": "node scripts/run.mjs ios release",
		"android:release": "node scripts/run.mjs android release",
		"pods": "cd ios && bundle exec pod install",
		"check": "tsc --noEmit",
		"test:unit": "node --import tsx --test test/*.test.ts",
		"bundle:ios": "node scripts/bundle.mjs ios",
		"bundle:android": "node scripts/bundle.mjs android",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown",
		"lint:nofmt": "eslint .",
		"lint:fix:nofmt": "eslint --fix ."
	},
	"dependencies": {
		"@ak5/api": "workspace:*",
		"@ak5/shared": "workspace:*",
		"@ak5/sync": "workspace:*",
		"@livestore/adapter-expo": "0.5.0",
		"@livestore/livestore": "0.5.0",
		"@livestore/peer-deps": "0.5.0",
		"expo": "58.0.17",
		"expo-application": "58.1.2",
		"expo-asset": "58.0.18",
		"expo-constants": "58.0.16",
		"expo-crypto": "58.0.7",
		"expo-modules-autolinking": "58.0.14",
		"expo-modules-core": "58.0.24",
		"expo-secure-store": "58.0.2",
		"expo-sqlite": "58.0.13",
		"hono": "^4.13.20",
		"react": "19.3.1",
		"react-native": "0.88.0",
		"react-native-safe-area-context": "5.10.1"
	},
	"type": "module",
	"expo": {
		"autolinking": {
			"android": {
				"buildFromSource": [
					".*"
				]
			},
			"exclude": [
				"expo-file-system",
				"expo-font",
				"expo-keep-awake",
				"@expo/dom-webview",
				"@expo/log-box"
			]
		}
	},
	"main": "index.js"
}
