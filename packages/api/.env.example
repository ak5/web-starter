# Neon Postgres direct connection string (live data — used by `pnpm dev`).
# Prefer the non-pooler Neon URL in dev so migrations / branch metadata behave.
# The prod worker secret can use Neon's pooled URL.
DATABASE_URL=postgres://user:pass@ep-example.eu-central-1.aws.neon.tech/db?sslmode=require

# Test-only Neon connection string. Playwright global-setup wipes this DB to
# empty before every run, then re-applies migrations. Point at a DEDICATED Neon
# branch (e.g. `test`) — never share with DATABASE_URL.
DATABASE_URL_TEST=postgres://user:pass@ep-example-test.eu-central-1.aws.neon.tech/test?sslmode=require

# Shared with @ak5/web and @ak5/admin (must match across all three workers).
JWT_SECRET=

# Cookie origin for cross-subdomain auth. This file is DEV only; deployed values
# live in wrangler.jsonc `vars` (staging) + worker secrets — see
# docs/operations/deployment.md.
# Dev: .ak5.localhost (or .ak5<n>.localhost for slot N).
# Staging: "" (host-only — workers.dev siblings can't share a domain).
# Prod: .ak5web.com (cross-subdomain SSO).
COOKIE_ORIGIN=.ak5.localhost

# Public URLs the api uses to construct links in emails / OAuth callbacks.
PUBLIC_API_URL=http://api.ak5.localhost:8359
PUBLIC_APP_URL=http://web.ak5.localhost:8359
PUBLIC_ADMIN_URL=http://admin.ak5.localhost:8359
PUBLIC_EMAIL_FROM=robot@ak5web.com

# Public base URL for R2-hosted assets (avatars, uploads).
PUBLIC_R2_URL=https://cdn.ak5web.com

# Transactional email.
# Dev points at the local mock. Deployed envs use the native EMAIL binding (no runtime API token).
EMAIL_MOCK_URL=http://mock.ak5.localhost:8359

# Discord OAuth login (the removable auth-oauth overlay). Optional log webhook.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_LOG_ENDPOINT=

# Token encryption (AES-256-GCM hex key, 32 bytes — `openssl rand -hex 32`).
TOKEN_ENCRYPTION_KEY=

# Neon API — used by `pnpm db:reset` (prod worker forks/restores dev branches).
# Leave blank locally; only the prod worker needs real values.
NEON_API_KEY=
NEON_PROJECT_ID=

# Cloudflare API — used by `/admin/integrations/cloudflare`. Read access to
# Workers scripts + analytics. Optional.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
