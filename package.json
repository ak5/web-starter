{
	"name": "ak5-web",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"rebrand": "node scripts/init.mjs",
		"dev": "bash scripts/dev-host.sh local 1 && bash scripts/dev-stack.sh",
		"dev:slot": "bash -c 'if [ \"$1\" = \"--\" ]; then shift; fi; bash scripts/dev-host.sh local \"$1\" && bash scripts/dev-stack.sh' _",
		"dev:auto": "bash -c 'slot=$(bash scripts/next-free-slot.sh) && echo \"Auto-picked slot $slot.\" && bash scripts/dev-host.sh local \"$slot\" && bash scripts/dev-stack.sh'",
		"dev:web": "pnpm --filter @ak5/web dev",
		"dev:admin": "pnpm --filter @ak5/admin dev",
		"dev:api": "pnpm --filter @ak5/api dev",
		"dev:email": "pnpm --filter @ak5/email dev",
		"dev:email:mock": "pnpm --filter @ak5/email dev:mock",
		"dev:email:preview": "pnpm --filter @ak5/email dev:preview",
		"email:test": "pnpm --filter @ak5/email test:send",
		"dev:shared": "pnpm --filter @ak5/shared dev",
		"dev:webui": "pnpm --filter @ak5/webui dev",
		"dev:app": "pnpm --filter @ak5/mobile dev",
		"dev:init": "pnpm build:libs && lefthook install && ./scripts/dev-init.sh",
		"rotate-jwt-secret": "./scripts/rotate-jwt-secret.sh",
		"build": "pnpm -r build",
		"build:libs": "pnpm --filter @ak5/shared build && pnpm --filter @ak5/email build && pnpm --filter @ak5/webui package && pnpm --filter @ak5/api build",
		"build:web": "pnpm build:libs && pnpm --filter @ak5/web build",
		"build:admin": "pnpm build:libs && pnpm --filter @ak5/admin build",
		"build:api": "pnpm --filter @ak5/api build",
		"preview": "pnpm --filter @ak5/web preview",
		"check": "pnpm -r check",
		"check:all": "pnpm build:libs && pnpm format && pnpm -r lint:nofmt && pnpm audit:split && pnpm check:docs && pnpm check",
		"format": "prettier --write . && pnpm -r format",
		"format:check": "prettier --check . && pnpm -r format:check",
		"lint": "prettier --check . && pnpm -r lint:nofmt",
		"lint:fix": "pnpm format && pnpm -r lint:fix:nofmt",
		"lint:nofmt": "pnpm -r lint:nofmt",
		"audit:split": "bash scripts/audit-split-boundaries.sh",
		"check:docs": "bash scripts/check-doc-links.sh",
		"clean": "pnpm -r exec rm -rf dist .svelte-kit .eslintcache",
		"test": "playwright test --project=api --project=web --project=admin",
		"test:headed": "playwright test --project=api --project=web --project=admin --headed",
		"test:ui": "playwright test --ui",
		"test:debug": "playwright test --debug",
		"test:api": "playwright test --project=api",
		"test:web": "playwright test --project=web",
		"test:admin": "playwright test --project=admin",
		"test:smoke": "playwright test --project=smoke",
		"test:report": "playwright show-report",
		"test:install": "playwright install --with-deps chromium",
		"test:preflight": "pnpm tsx scripts/preflight.ts",
		"test:unit": "node --test scripts/preflight.test.mjs scripts/init.test.mjs scripts/sync-cloudflare-worker-secrets.test.mjs && node --test --import tsx packages/webui/src/lib/sveltekit-handle.test.ts && node scripts/verify-promotion.mjs && node scripts/configure-preview.mjs --test && node scripts/configure-d1.mjs --test && pnpm --filter @ak5/cli test:unit && pnpm --filter @ak5/email test:unit && pnpm --filter @ak5/shared test:unit && pnpm --filter @ak5/api test:unit && pnpm --filter @ak5/mobile test:unit && pnpm --filter @ak5/sync test:unit",
		"check:mobile": "pnpm --filter @ak5/mobile check && pnpm --filter @ak5/mobile test:unit",
		"gen": "pnpm -r --if-present --parallel run gen",
		"cf-typegen": "pnpm gen",
		"db:migrate": "pnpm --filter @ak5/api db:migrate",
		"db:generate": "pnpm --filter @ak5/api db:generate",
		"create:admin": "pnpm --filter @ak5/api create:admin",
		"wrangler": "pnpm --filter @ak5/api exec wrangler",
		"cli": "pnpm --filter @ak5/cli start",
		"app:ios": "pnpm --filter @ak5/mobile ios",
		"app:android": "pnpm --filter @ak5/mobile android",
		"app:pods": "pnpm --filter @ak5/mobile pods",
		"build:mobile": "pnpm --filter @ak5/mobile bundle:ios && pnpm --filter @ak5/mobile bundle:android",
		"test:db": "pnpm --filter @ak5/api test:db",
		"db:migrate:staging": "pnpm --filter @ak5/api db:migrate:staging",
		"db:migrate:prod": "pnpm --filter @ak5/api db:migrate:prod"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"concurrently": "^9.2.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=10.32.1"
	},
	"packageManager": "pnpm@10.32.1"
}
